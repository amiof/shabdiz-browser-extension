{
  "name": "shabdiz-dm-extension",
  "displayName": "Shabdiz download manager extension",
  "version": "1.0.0",
  "description": "this extension send downloads link to shabdiz download manager app",
  "author": "amiof",
  "scripts": {
    "dev": "plasmo dev --target=chrome-mv3",
    "dev:chrome": "plasmo dev --target=chrome-mv3",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:all": "npm run build",
    "build:chrome": "plasmo build --target=chrome-mv3",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "npm run package:chrome && npm run package:firefox",
    "package:all": "npm run package",
    "package:chrome": "plasmo package --target=chrome-mv3",
    "package:firefox": "plasmo package --target=firefox-mv3",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "contextMenus",
      "downloads",
      "storage",
      "webRequest",
      "scripting"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "shabdiz@amiof",
        "strict_min_version": "109.0"
      }
    }
  }
}
